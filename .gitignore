/research/**/*.html
/research/**/*.pdf
/research/*.txt
/research/crawl/*.html
/research/factoruide/
/research/questie/*.lua
/research/questie/*.md
/research/questie/*.toc
/research/questie/.gitmodules

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
.codex/
.agents/
.aws/
